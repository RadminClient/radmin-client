{
  "schemaVersion": 1,
  "name": "RadminVPN Client",
  "id": "radmin-client",
  "version": "${version}",
  "description": "Based utility mod for RadminVPN and Aternos servers.",
  "authors": [
    "MineGame159",
    "squidoodly",
    "seasnail"
  ],
  "contact": {
    "homepage": "https://meteorclient.com",
    "issues": "https://github.com/RadminClient/radmin-client/issues",
    "sources": "https://github.com/RadminClient/radmin-client",
    "discord": "https://meteorclient.com/discord"
  },
  "license": "GPL-3.0",
  "icon": "assets/radmin-client/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "radmin.client.MeteorClient"
    ],
    "modmenu": [
      "radmin.client.modintegration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "radmin-client.mixins.json",
    "radmin-client-baritone.mixins.json",
    "radmin-client-indigo.mixins.json",
    "radmin-client-sodium.mixins.json",
    "radmin-client-lithium.mixins.json",
    "radmin-client-metallum.mixins.json"
  ],
  "accessWidener": "radmin-client.classtweaker",
  "custom": {
    "radmin-client:build_number": "${build_number}",
    "radmin-client:color": "145,61,226",
    "radmin-client:commit": "${commit}",
    "modmenu": {
      "links": {
        "modmenu.discord": "https://meteorclient.com/discord"
      }
    },
    "badoptimizations:cache_hooks": {
      "lightmap": "radmin.client.modintegration.BadOptimizationsHook"
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${loader_version}"
  },
  "breaks": {
    "optifabric": "*",
    "feather": "*",
    "origins": "*",
    "sodium": "<0.9.1",
    "morechathistory": "*",
    "lithium": "<0.22.1"
  }
}
